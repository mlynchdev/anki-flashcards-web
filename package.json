{
  "name": "anki-flashcards-web",
  "version": "0.1.0",
  "private": true,
  "description": "Open-source, mobile-first spaced repetition PWA modeled on AnkiMobile. Bring your own decks.",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build && node scripts/check-dist.mjs",
    "preview": "vite preview",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "deploy": "npm run build && wrangler deploy"
  },
  "dependencies": {
    "dompurify": "^3.4.17",
    "fflate": "^0.8.3",
    "fzstd": "^0.1.1",
    "idb": "^8.0.4",
    "preact": "^11.1.0",
    "sql.js": "^1.15.2"
  },
  "devDependencies": {
    "@babel/core": "^7.29.7",
    "@preact/preset-vite": "^2.10.6",
    "@types/sql.js": "^1.4.11",
    "fake-indexeddb": "^6.2.6",
    "ts-fsrs": "^5.4.2",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vite-plugin-pwa": "^2.0.0",
    "vitest": "^5.0.5",
    "workbox-build": "^7.4.1",
    "workbox-window": "^7.4.1"
  }
}
